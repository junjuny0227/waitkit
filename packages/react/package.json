{
  "name": "@waitkit/react",
  "version": "0.4.1",
  "description": "React provider, hooks, and floating devtools panel for Waitkit.",
  "keywords": [
    "devtools",
    "fetch",
    "loading",
    "react",
    "testing",
    "timeout"
  ],
  "homepage": "https://github.com/junjuny0227/waitkit/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/junjuny0227/waitkit/issues"
  },
  "license": "Apache-2.0",
  "author": "junjuny0227",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjuny0227/waitkit.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "check-types": "tsc"
  },
  "dependencies": {
    "@waitkit/core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
