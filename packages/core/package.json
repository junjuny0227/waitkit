{
  "name": "@waitkit/core",
  "version": "0.5.0",
  "description": "Development-only network simulation for fetch: delays, error responses, and timeouts driven by rules and scenarios.",
  "keywords": [
    "delay",
    "fetch",
    "latency",
    "loading",
    "mock",
    "network",
    "testing",
    "timeout"
  ],
  "homepage": "https://github.com/junjuny0227/waitkit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/junjuny0227/waitkit/issues"
  },
  "license": "Apache-2.0",
  "author": "junjuny0227",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjuny0227/waitkit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "check-types": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "publint": "^0.3.25",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
